      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "Agent(claude)",
      "Agent(mercadopago:mp-integration-expert)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--delete*)",
      "Bash(*--no-verify*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push -f*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git -C * push * +*)",
      "Bash(git -C * push +*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -C * commit -n*)",
      "Bash(git -C * commit * -n*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean:*)",
