{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "syncClaudeAiSkills": false,
  "env": {
    "PONYTAIL_DEFAULT_MODE": "off"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh run view *)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker info*)",
      "Bash(docker ps*)",
      "mcp__codegraph__codegraph_explore",
      "mcp__engram"
    ],
    "deny": [
      "Agent(orchestrator)",
      "Agent(general-purpose)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(statusline-setup)",
      "Agent(claude)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *--delete*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean:*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.next/**)",
      "Read(**/.svelte-kit/**)",
      "Read(**/new-database/**)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(rm -rf /*)",
      "Bash(reboot)",
      "Bash(reboot *)",
      "Bash(shutdown)",
      "Bash(shutdown *)",
      "Bash(*vps*reboot*)",
      "Bash(*vps*shutdown*)",
      "Bash(*vps*docker system prune*)",
      "Bash(*vps*docker volume rm*)",
      "Bash(*vps*docker volume prune*)",
      "Bash(*vps*rm -rf /*)",
      "Bash(*vps*apt remove*)",
      "Bash(*vps*apt purge*)",
      "Bash(*vps*apt-get remove*)",
      "Bash(*vps*apt-get purge*)",
      "Bash(*vps*ufw disable*)",
      "Bash(*vps*ufw reset*)",
      "Bash(*vps*userdel*)",
      "Bash(*vps*passwd*)",
      "Bash(*vps*sshd_config*)",
      "Bash(*vps*sudoers*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(gh secret *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(docker rm *)",
      "Bash(docker compose down *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl restart *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker exec *)",
      "Bash(docker compose up *)",
      "Bash(systemctl disable *)",
      "Bash(ufw *)",
      "mcp__claude-in-chrome",
      "Bash(*vps*docker restart*)",
      "Bash(*vps*docker stop*)",
      "Bash(*vps*docker rm *)",
      "Bash(*vps*docker exec*)",
      "Bash(*vps*docker compose up*)",
      "Bash(*vps*docker compose down*)",
      "Bash(*vps*systemctl restart*)",
      "Bash(*vps*systemctl stop*)",
      "Bash(*vps*systemctl disable*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/guard-subagent-git.js"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js",
    "padding": 0
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "engram@engram": true,
    "typescript-lsp@claude-plugins-official": true,
    "mercadopago@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "feedbackDrafts": "off",
  "autoCompactWindow": 300000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agent": "orchestrator",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true
}
