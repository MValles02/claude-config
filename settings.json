      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.next/**)",
      "Read(**/.svelte-kit/**)",
      "Read(**/new-database/**)",
      "Read(~/.secrets/**)",
      "Read(~/.claude/backups/**)",
      "Read(**/.credentials.json)",
      "Bash(cat *.env)",
      "Bash(cat *.env *)",
      "Bash(cat *.env.local*)",
      "Bash(cat *.env.*.local*)",
      "Bash(cat *.env.prod*)",
      "Bash(cat *.env.dev*)",
      "Bash(cat *.env.staging*)",
      "Bash(cat *.env.test*)",
      "Bash(head *.env)",
      "Bash(head *.env *)",
      "Bash(head *.env.local*)",
