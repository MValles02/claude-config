      "Bash(head *.env.prod*)",
      "Bash(head *.env.dev*)",
      "Bash(head *.env.staging*)",
      "Bash(head *.env.test*)",
      "Bash(tail *.env)",
      "Bash(tail *.env *)",
      "Bash(tail *.env.local*)",
      "Bash(tail *.env.*.local*)",
      "Bash(tail *.env.prod*)",
      "Bash(tail *.env.dev*)",
      "Bash(tail *.env.staging*)",
      "Bash(tail *.env.test*)",
      "Bash(less *.env)",
      "Bash(less *.env *)",
      "Bash(less *.env.local*)",
      "Bash(less *.env.*.local*)",
      "Bash(less *.env.prod*)",
      "Bash(less *.env.dev*)",
      "Bash(less *.env.staging*)",
      "Bash(less *.env.test*)",
      "Bash(more *.env)",
      "Bash(more *.env *)",
      "Bash(more *.env.local*)",
      "Bash(more *.env.*.local*)",
      "Bash(more *.env.prod*)",
      "Bash(more *.env.dev*)",
      "Bash(more *.env.staging*)",
      "Bash(more *.env.test*)",
      "Bash(bat *.env)",
      "Bash(bat *.env *)",
      "Bash(bat *.env.local*)",
      "Bash(bat *.env.*.local*)",
      "Bash(bat *.env.prod*)",
      "Bash(bat *.env.dev*)",
      "Bash(bat *.env.staging*)",
      "Bash(bat *.env.test*)",
      "Bash(node -e *'.env*)",
      "Bash(node -e *\".env*)",
      "Bash(node -e */.env*)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(Get-Content *.env *)",
      "PowerShell(Get-Content *.env.local*)",
      "PowerShell(Get-Content *.env.*.local*)",
      "PowerShell(Get-Content *.env.prod*)",
      "PowerShell(Get-Content *.env.dev*)",
      "PowerShell(Get-Content *.env.staging*)",
      "PowerShell(Get-Content *.env.test*)",
      "Bash(*.credentials.json*)",
      "Bash(*/.secrets/*)",
