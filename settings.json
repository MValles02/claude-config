      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh run view *)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker info*)",
      "Bash(docker ps*)",
      "mcp__codegraph__codegraph_explore",
      "mcp__engram",
      "Bash(git push:*)",
      "Bash(node ~/.claude/scripts/merge-develop-without-ci.mjs *)",
      "Bash(node C:/Users/Mateo/.claude/scripts/merge-develop-without-ci.mjs *)",
      "Bash(docker build *)",
      "Bash(docker push ghcr.io/mvalles02/*)",
      "Bash(gh variable get *)",
      "mcp__ccd_pr__set_auto_merge"
