{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "syncClaudeAiSkills": false,
  "env": {
    "PONYTAIL_SUBAGENT_MATCHER": "^implementer$"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run view *)",
      "mcp__codegraph__codegraph_explore",
      "mcp__plugin_engram_engram__mem_search",
      "mcp__plugin_engram_engram__mem_context",
      "mcp__plugin_engram_engram__mem_current_project",
      "mcp__plugin_engram_engram__mem_get_observation",
      "mcp__plugin_engram_engram__mem_save",
      "mcp__plugin_engram_engram__mem_session_summary"
    ],
    "deny": [
      "Agent(orchestrator)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(.env*)",
      "Read(!.env.example)",
      "Read(**/.next/**)",
      "Read(**/.svelte-kit/**)",
      "Read(**/new-database/**)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(rm -rf /*)",
      "Bash(reboot)",
      "Bash(reboot *)",
      "Bash(shutdown)",
      "Bash(shutdown *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(gh secret *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(docker rm *)",
      "Bash(docker compose down *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl restart *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker exec *)",
      "Bash(docker compose up *)",
      "Bash(systemctl disable *)",
      "Bash(ufw *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/auto-title.js"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js",
    "padding": 0
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "engram@engram": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false
}
