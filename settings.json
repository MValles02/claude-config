      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(gh pr view *)",
