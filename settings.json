    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(gh secret *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(docker rm *)",
      "Bash(docker compose down *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl restart *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker exec *)",
      "Bash(docker compose up *)",
      "Bash(systemctl disable *)",
      "Bash(ufw *)",
      "mcp__claude-in-chrome",
      "Bash(*vps*docker restart*)",
      "Bash(*vps*docker stop*)",
      "Bash(*vps*docker rm *)",
      "Bash(*vps*docker exec*)",
      "Bash(*vps*docker compose up*)",
      "Bash(*vps*docker compose down*)",
      "Bash(*vps*systemctl restart*)",
      "Bash(*vps*systemctl stop*)",
      "Bash(*vps*systemctl disable*)",
      "mcp__cloudflare__execute"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/guard-subagent-git.js"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js",
    "padding": 0
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "frontend-design@claude-plugins-official": true,
    "engram@engram": true,
    "typescript-lsp@claude-plugins-official": true,
    "mercadopago@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "feedbackDrafts": "off",
  "autoCompactWindow": 300000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agent": "orchestrator",
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": false,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true
}
