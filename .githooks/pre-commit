#!/bin/sh
# Secret scan of staged changes, same digest-pinned image as CI.
# The diff is piped via stdin because a `-v $PWD:/repo` git mount breaks inside worktrees.
if command -v docker >/dev/null 2>&1; then
  git diff --cached --no-color -U0 | docker run --rm -i ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f stdin --redact --exit-code 1
else
  echo "warning: docker not found, skipping gitleaks staged scan" >&2
fi
